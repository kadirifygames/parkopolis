# Metin dosyalarında satır sonlarını Git otomatik düzenlesin (Windows <-> Mac sorunsuz)
* text=auto

# Unity metin dosyaları
*.cs text diff=csharp
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf

# İkili (binary) dosyalar: Git içlerine dokunmasın
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.fbx binary
